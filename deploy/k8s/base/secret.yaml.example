# kanban Secrets 键清单（文档示例，请勿直接 apply）。
#
# 实际 Secret「kanban-secrets」由 scripts/deploy.sh 首次运行时自动生成（随机值）。
# 也可用环境变量覆盖复用既有密钥：
#   JWT_SECRET / DATASOURCE_SECRET / POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB /
#   DB_URL / REDIS_URL / ADMIN_INITIAL_PASSWORD
#（若仓库根 deploy/.env 存在，deploy.sh 会自动复用其中的 JWT_SECRET / DATASOURCE_SECRET /
#   POSTGRES_PASSWORD / ADMIN_INITIAL_PASSWORD。）
#
# 需手动创建时格式如下（stringData 无需 base64）：
apiVersion: v1
kind: Secret
metadata:
  name: kanban-secrets
  namespace: kanban
type: Opaque
stringData:
  JWT_SECRET: ""
  DATASOURCE_SECRET: ""
  POSTGRES_USER: kanban
  POSTGRES_PASSWORD: ""
  POSTGRES_DB: kanban
  DB_URL: postgresql://kanban:CHANGE_ME@postgres:5432/kanban
  REDIS_URL: redis://redis:6379/0
  ADMIN_INITIAL_PASSWORD: admin123