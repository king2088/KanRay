# ---------- 通用 ----------
KANBAN_PORT=8080
JWT_SECRET=
DATASOURCE_SECRET=
ADMIN_INITIAL_PASSWORD=admin123

# ---------- 默认 stack：PostgreSQL（docker-compose.yml）----------
POSTGRES_USER=kanban
POSTGRES_PASSWORD=
POSTGRES_DB=kanban

# ---------- 可选 stack：MySQL / MariaDB ----------
# 留空时 compose 使用内置默认值 kanban；生产请改为强密码（特殊字符需在连接串 URL 编码）
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=kanban
MARIADB_ROOT_PASSWORD=
MARIADB_DATABASE=kanban

# ---------- 可选：Redis ----------
# PG/MySQL/MariaDB 栈默认注入 redis://redis:6379/0；自定义密码/外部 Redis 时覆盖此项
# REDIS_URL=redis://:yourpass@redis:6379/0
