# ---------- 通用 ----------
KANRAY_PORT=8080
JWT_SECRET=
DATASOURCE_SECRET=
ADMIN_INITIAL_PASSWORD=admin123

# ---------- 默认 stack：PostgreSQL（docker-compose.yml）----------
POSTGRES_USER=kanray
POSTGRES_PASSWORD=
POSTGRES_DB=kanray

# ---------- 可选 stack：MySQL / MariaDB ----------
# 留空时 compose 使用内置默认值 kanray；生产请改为强密码（特殊字符需在连接串 URL 编码）
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=kanray
MARIADB_ROOT_PASSWORD=
MARIADB_DATABASE=kanray

# ---------- 可选：Redis ----------
# PG/MySQL/MariaDB 栈默认注入 redis://redis:6379/0；自定义密码/外部 Redis 时覆盖此项
# 主栈（docker-compose.yml）设 REDIS_PASSWORD 后 redis 自动开启 requirepass，backend/worker 同步携带认证
# REDIS_PASSWORD=
# REDIS_URL=redis://:yourpass@redis:6379/0
