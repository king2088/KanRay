# Kanban 后端环境变量示例
# 复制为 .env 后按需修改（当前启动不自动加载，需在 shell 中 export）

# 服务监听端口（默认 3001）
PORT=3001

# 存储后端类型（默认 sqlite）：sqlite / mysql / mariadb / postgres / sqlserver / oracle
# DB_TYPE=sqlite

# 非 sqlite 时的 JDBC 风格连接串（如 mysql://root:pass@127.0.0.1:13306/kanban）
# DB_URL=

# 元数据库文件路径（默认 <DATA_DIR>/kanban.db，测试会覆盖）
# DB_PATH=./data/kanban.db

# 数据目录（默认 backend/data）
DATA_DIR=./data

# 上传目录（默认 backend/uploads）
UPLOAD_DIR=./uploads

# JWT 签名密钥（生产环境必须设置，否则启用默认值并打印告警）
JWT_SECRET=replace-with-a-long-random-string

# 数据源密码加密主密钥（生产必须设置并固定，否则历史数据源密码无法解密）
# DATASOURCE_SECRET=

# 访问令牌有效期（默认 15m，支持 ms/s/m/h/d）
ACCESS_TTL=15m

# 刷新令牌有效期（天，默认 7）
REFRESH_TTL_DAYS=7

# 默认管理员邮箱（种子数据，默认 admin@kanban.local）
ADMIN_EMAIL=admin@kanban.local

# 默认管理员初始密码（种子数据，生产环境必须设置，否则启用默认值并打印告警）
ADMIN_INITIAL_PASSWORD=admin123

# 上传文件大小上限（字节，默认 20MB）
MAX_FILE_SIZE=20971520

# 导入数据集最大行数（默认 20 万）
MAX_ROWS=200000

# Redis 缓存/锁开关（空则内存缓存 + 数据库租约锁）；
# 用户名/密码/库号写在 URL 里，如 redis://:pass@127.0.0.1:6379/0，TLS 用 rediss://
# REDIS_URL=

# 数据源目录缓存 TTL（毫秒，默认 60000）
# CACHE_TTL_MS=60000

# 同步调度锁租约时长（毫秒，默认 1800000）
# SYNC_LOCK_TTL_MS=1800000
